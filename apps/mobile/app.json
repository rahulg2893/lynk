{
  "expo": {
    "name": "Lynk",
    "slug": "lynk",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "lynk",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#070c16",
    "ios": {
      "bundleIdentifier": "com.rahulgandhi.lynk",
      "icon": "./assets/images/icon.png",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "FVZ6LNZACV"
    },
    "android": {
      "package": "com.rahulgandhi.lynk",
      "adaptiveIcon": {
        "backgroundColor": "#0f182b",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070c16",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 280,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Lynk uses the microphone to record voice notes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lynk lets you choose photos to send in your chats.",
          "cameraPermission": "Lynk lets you take photos to send in your chats."
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-localization",
      "@react-native-community/datetimepicker",
      "expo-asset",
      "./plugins/with-quoted-bundle-script",
      "./plugins/with-scene-lifecycle",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
